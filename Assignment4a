import java.util.Scanner;

public class Assignment4a{
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter height (in cm): ");
        double height = input.nextDouble();

        System.out.print("Enter age: ");
        int age = input.nextInt();

        System.out.print("Enter citizenship code (C or N): ");
        String citizen = input.next();

        System.out.print("Enter recommendee code (R or N): ");
        String recommendee = input.next();

        if (recommendee.equalsIgnoreCase("R")) {
            System.out.println("Status: Accepted");
        } else if (height >= 200 && age >= 21 && age <= 25 && citizen.equalsIgnoreCase("C")) {
            System.out.println("Status: Accepted");
        } else {
            System.out.println("Status: Rejected");
        }

        input.close();
    }
}
