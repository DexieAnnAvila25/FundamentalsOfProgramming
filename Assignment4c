import javax.swing.JOptionPane;

public class Assignment4c {
    public static void main(String[] args) {
        String heightInput = JOptionPane.showInputDialog("Enter height (in cm):");
        double height = Double.parseDouble(heightInput);

        String ageInput = JOptionPane.showInputDialog("Enter age:");
        int age = Integer.parseInt(ageInput);

        String citizen = JOptionPane.showInputDialog("Enter citizenship code (C/N):");
        String recommendee = JOptionPane.showInputDialog("Enter recommendee code (R/N):");

        if (recommendee.equalsIgnoreCase("R")) {
            JOptionPane.showMessageDialog(null, "Status: Accepted");
        } else if (height >= 200 && age >= 21 && age <= 25 && citizen.equalsIgnoreCase("C")) {
            JOptionPane.showMessageDialog(null, "Status: Accepted");
        } else {
            JOptionPane.showMessageDialog(null, "Status: Rejected");
        }
    }
}
