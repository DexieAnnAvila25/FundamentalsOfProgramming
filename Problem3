package org.example;
import javax.swing.JOptionPane;
public class Problem3 {
        public static void main(String[] args) {
            double balance = 20000.00;
            double transaction;

            while (true) {
                String inputStr = JOptionPane.showInputDialog(
                        "Current Balance: P" + String.format("%.2f", balance) +
                                "\nEnter transaction amount\n(Positive for Deposit, Negative for Withdrawal, 0 to Exit):"
                );

                // Handle cancel button or empty inputs safely
                if (inputStr == null) {
                    break;
                }

                transaction = Double.parseDouble(inputStr);

                if (transaction == 0) {
                    break;
                }

                if (transaction > 0) {
                    balance += transaction;
                    JOptionPane.showMessageDialog(null, "Deposit successful!\nOutstanding Balance: P" + String.format("%.2f", balance));
                } else {
                    double withdrawalAmount = Math.abs(transaction);
                    if (withdrawalAmount > balance) {
                        JOptionPane.showMessageDialog(null, "INSUFFICIENT FUNDS!", "Error", JOptionPane.ERROR_MESSAGE);
                    } else {
                        balance -= withdrawalAmount;
                        JOptionPane.showMessageDialog(null, "Withdrawal successful!\nOutstanding Balance: P" + String.format("%.2f", balance));
                    }
                }
            }

            JOptionPane.showMessageDialog(null, "Program terminated.\nFinal Balance: P" + String.format("%.2f", balance));
        }
    }
