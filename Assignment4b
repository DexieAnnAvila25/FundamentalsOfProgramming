import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;

public class Assignment4b{
    public static void main(String[] args) throws IOException {
        BufferedReader reader = new BufferedReader(new InputStreamReader(System.in));

        System.out.print("Enter height (in cm): ");
        double height = Double.parseDouble(reader.readLine());

        System.out.print("Enter age: ");
        int age = Integer.parseInt(reader.readLine());

        System.out.print("Enter citizenship code (C/N): ");
        String citizen = reader.readLine();

        System.out.print("Enter recommendee code (R/N): ");
        String recommendee = reader.readLine();

        if (recommendee.equalsIgnoreCase("R")) {
            System.out.println("Status: Accepted");
        } else if (height >= 200 && age >= 21 && age <= 25 && citizen.equalsIgnoreCase("C")) {
            System.out.println("Status: Accepted");
        } else {
            System.out.println("Status: Rejected");
        }
    }
}
